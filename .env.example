# Copie este arquivo para .env e preencha com os valores do seu projeto Supabase.
# Estas três variáveis são PÚBLICAS por natureza (prefixo VITE_ = vão para o
# bundle do navegador). A chave "publishable/anon" NÃO é um segredo — ela só
# funciona porque as tabelas têm RLS habilitado no Supabase. Ainda assim, o
# arquivo .env em si não é versionado (ver .gitignore) por hábito de segurança.

VITE_SUPABASE_PROJECT_ID="seu-project-id-aqui"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-anon-key-aqui"
VITE_SUPABASE_URL="https://seu-project-id-aqui.supabase.co"
